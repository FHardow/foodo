# Public domain (no protocol, no trailing slash)
DOMAIN=example.com

# TLS — email for Let's Encrypt notifications (only needed in docker-compose.traefik.yml)
ACME_EMAIL=you@example.com

# PostgreSQL
DB_USER=foodo
DB_PASSWORD=changeme
DB_NAME=foodo

# CORS — set to the frontend origin for local dev; leave empty in prod (same-origin via Traefik)
CORS_ORIGIN=

# Keycloak — external instance, not managed by this compose file
KEYCLOAK_URL=https://auth.example.com
KEYCLOAK_REALM=foodo
KEYCLOAK_CLIENT_ID=foodo-app

# Baked into the frontend at build time
VITE_KEYCLOAK_URL=https://auth.example.com
VITE_KEYCLOAK_CLIENT_ID=foodo-app

# Web Push — customer notifications on order status changes.
# Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# REQUIRED — the backend will not start without this, even if push notifications
# are unused. 32 random bytes, base64-encoded. Generate with: openssl rand -base64 32
PUSH_ENCRYPTION_KEY=

# Baked into the frontend at build time — same value as VAPID_PUBLIC_KEY above
VITE_VAPID_PUBLIC_KEY=
